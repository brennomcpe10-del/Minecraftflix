rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /series/{seriesId} {
      allow read, write: if true;
    }
    match /portal_metadata/{docId} {
      allow read, write: if true;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
